    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.4",
    "yup": "^1.4.0"
